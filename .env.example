# Copia a .env y ajusta. Todas las variables tienen valor por defecto.

PORT=8080
TZ=Europe/Madrid
DATA_DIR=/app/data

# --- Google Sheets ----------------------------------------------------------
SYNC_ENABLED=false
GOOGLE_SHEETS_CREDENTIALS_FILE=/app/credentials.json
# Por nombre de hoja...
GOOGLE_SHEET_NAME=Kiki
# ...o por id (tiene prioridad si se informa)
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET_NAME=Kikis
SYNC_ON_STARTUP=true
SYNC_INTERVAL_MINUTES=360
SYNC_PUSH_DEBOUNCE_SECONDS=5
