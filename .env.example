# Copia a .env y ajusta. Todas las variables tienen valor por defecto.
#
# No hay secretos: la app no habla con ningún servicio externo. El histórico
# se trae una sola vez subiendo el fichero desde el propio dashboard.

# Puerto de escucha.
PORT=8080

# Zona horaria con la que se calcula "hoy" y, por tanto, los días sin Kiki.
TZ=Europe/Madrid

# Carpeta del volumen donde vive kiki.db.
DATA_DIR=/app/data
